@echo off
rem ---------------------------------------------------------------------------
rem dsh-local.cmd - project-local DeepSeek Harness launcher for the dsh-superagent
rem deployment. Mirrors C:\Users\<you>\.dsh\bin\dsh.cmd, but pins DSH_HOME to
rem this project so no file under the real %USERPROFILE%\.dsh is read or written
rem by superagent profiles. Generated by deploy-runner (task-2), measured on
rem Windows 11 26200 / dsh 0.2.1-rc.4.
rem ---------------------------------------------------------------------------
setlocal DisableDelayedExpansion
set "ELECTRON_RUN_AS_NODE=1"
set "DSH_DESKTOP_DEFAULT_PROFILE=desktop"
set "DSH_HOME=G:\Agent-workspace\dsh-superagent\deploy\dsh-home"
set "DSH_DESKTOP_APP_EXECUTABLE=G:\Agent-workspace\dsh-superagent\..\DSH NEXT\DSH NEXT.exe"
set "DSH_DESKTOP_DSH_BOOTSTRAP=G:\Agent-workspace\dsh-superagent\..\DSH NEXT\resources\app.asar\lib\desktop-cli.js"
"%DSH_DESKTOP_APP_EXECUTABLE%" --expose-internals "%DSH_DESKTOP_DSH_BOOTSTRAP%" %*
exit /b %errorlevel%
